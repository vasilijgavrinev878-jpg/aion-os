# ─── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=aion_os_bot

# ─── Database ────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=aion
POSTGRES_USER=aion
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=changeme_in_production_generate_random_64_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LLM Configuration ───────────────────────────────────
# Default provider: deepseek, qwen, llama, openai
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-chat

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# Qwen (local)
QWEN_API_BASE=http://llm:8000/v1
QWEN_MODEL=qwen3-32b

# Llama (local via Ollama)
LLAMA_API_BASE=http://ollama:11434/v1
LLAMA_MODEL=llama3.1:70b

# OpenAI compatible (Groq, etc.)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# ─── Embeddings ──────────────────────────────────────────
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMENSIONS=1024
EMBEDDINGS_API_BASE=http://embeddings:8001/v1

# ─── Voice ───────────────────────────────────────────────
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=kokoro-82m
TTS_VOICE=af_bella
TTS_SPEED=1.0

# ─── RAG ─────────────────────────────────────────────────
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.65

# ─── Memory ──────────────────────────────────────────────
MEMORY_MAX_HISTORY=100
MEMORY_SUMMARY_INTERVAL=10

# ─── WebSocket ───────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=10000

# ─── Admin ───────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production
ADMIN_SECRET_KEY=changeme_in_production

# ─── Logging ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
