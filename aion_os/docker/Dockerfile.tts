FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Kokoro and dependencies
RUN pip install --no-cache-dir \
    kokoro>=0.3.0 \
    soundfile>=0.12.1 \
    torch>=2.4.0 \
    fastapi>=0.115.0 \
    uvicorn>=0.30.0

# Copy TTS server
COPY tts_server.py .

EXPOSE 5001

CMD ["uvicorn", "tts_server:app", "--host", "0.0.0.0", "--port", "5001"]
